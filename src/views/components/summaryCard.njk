{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "components/renderSummaryValue.njk" import renderSummaryValue %}

{% macro summaryCard(id, title, rows, action) %}

{% set govukRows = [] %}

{% for row in rows %}

  {% set valueHtml %}
    {{ renderSummaryValue(t, row.value) }}
  {% endset %}

  {% set govukRow = {
    key: {
      text: row.key | translate
    },
    value: {
      html: valueHtml | safe
    },
    actions: row.actions
  } %}

  {% set govukRows = govukRows.concat([govukRow]) %}

{% endfor %}

{% set card = {
  title: {
    text: title | translate
  },
  attributes: {
    "id": id
  }
} %}

{% if action %}
  {% set card = {
    title: card.title,
    actions: {
      items: [ action | translate ]
    },
    attributes: card.attributes
  } %}
{% endif %}

{{ govukSummaryList({
  card: card,
  rows: govukRows,
  attributes: {
    "id": id + "-rows"
  }
}) }}

{% endmacro %}