{% from "govuk/components/tag/macro.njk" import govukTag %}

{% macro renderSummaryValue(t, value) %}

  {% if value.type == "text" %}

    {{ value.value | translate }}

  {% elseif value.type == "texts" %}

    {% for value in value.values %}
      {{ value | translate }}{% if not loop.last %}<br>{% endif %}
    {% endfor %}

  {% elseif value.type == "tag" %}

    {% set tag = govukTag(value.tag | translate) %}

    <div class="govuk-summary-list__value-split">
      <span>{{ value.value | translate }}</span>
      <span class="govuk-summary-list__value-split-right">
        {{ tag | safe }}
      </span>
    </div>

  {% elseif value.type == "link" %}

    <a class="govuk-link" href="{{ value.value.href }}">{{ value.value.text | translate }}</a>

  {% endif %}

{% endmacro %}